APP_ENV=development
APP_SECRET_KEY=change-me
APP_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_PUBLIC_BASE_URL=
DATABASE_URL=postgresql+psycopg://ml:ml@localhost:5432/ml_enterprise
CORS_ORIGINS=http://localhost:5173

ML_API_BASE_URL=https://api.mercadolibre.com
ML_AUTH_BASE_URL=https://auth.mercadolibre.com.ar
ML_SITE_ID=MLA
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
ML_METADATA_TTL_SECONDS=86400
ML_KEYWORD_TRENDS_TTL_SECONDS=86400
ML_REQUEST_TIMEOUT_SECONDS=20
ML_LIVE_PUBLICATION_ENABLED=false

KEYWORD_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
KEYWORD_MAX_TRENDS=50
KEYWORD_MAX_SELECTED_TERMS=12
KEYWORD_MIN_SEMANTIC_SIMILARITY=0.35

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REQUEST_TIMEOUT_SECONDS=45

UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760
ML_IMAGE_MIN_SIDE_PX=500
ML_IMAGE_RECOMMENDED_SIDE_PX=1200
ML_IMAGE_ALLOWED_FORMATS_CSV=JPEG,JPG,PNG

WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=4
WORKER_BASE_BACKOFF_SECONDS=2

WORKER_HEARTBEAT_STALE_SECONDS=30
